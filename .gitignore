.dsh-qtrans/
.dsh-port/
.dsh-shuttle/
out/
*.dshsess.zip

# 密钥与凭据：密码只存环境变量名，任何情况下都不进仓库
.env
.env.*
.credentials.yaml
*.local.json
secrets/

# 系统与编辑器
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
*.stackdump
.idea/
.vscode/
*.swp

# 日志与临时文件
*.log
npm-debug.log*
*.tmp
*.bak
*~

# 以下内容是随仓分发的「第三方副本」，必须提交，不要加进忽略：
#   .agents/skills/**            项目技能包
#   scripts/harness/**           门禁校验器副本（任何 clone 都要能独立跑门禁）
